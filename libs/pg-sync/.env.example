# =============================================================================
# 🗄️ POSTGRES DATABASE CONFIGURATION
# =============================================================================
# Konfiguriere deine Postgres-Verbindung (Supabase, Coolify, oder lokal).
# NIEMALS diese Datei mit echten Credentials committen!
# Kopiere diese Datei nach .env.local und fülle die Werte aus.
# =============================================================================

# Postgres Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
#
# Beispiele:
# - Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# - Coolify: postgresql://user:password@your-server.com:5432/automaker
# - Lokal: postgresql://postgres:postgres@localhost:5432/automaker
DATABASE_URL=postgresql://postgres:password@localhost:5432/automaker

# =============================================================================
# 🔄 SYNC CONFIGURATION
# =============================================================================

# Sync aktivieren/deaktivieren
SYNC_ENABLED=true

# Auto-Sync Intervall in Millisekunden (Standard: 1 Stunde = 3600000)
SYNC_INTERVAL_MS=3600000

# Automatischer Push bei lokalen Änderungen
SYNC_AUTO_PUSH=true

# Automatischer Pull bei App-Start
SYNC_AUTO_PULL=true

# Konflikt-Strategie: 'local_wins' | 'remote_wins' | 'manual'
SYNC_CONFLICT_STRATEGY=remote_wins
