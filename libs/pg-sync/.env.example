# =============================================================================
# 🔐 SUPABASE CONFIGURATION
# =============================================================================
# Erstelle ein Projekt auf https://supabase.com und kopiere die Keys hier rein.
# NIEMALS diese Datei mit echten Keys committen!
# Kopiere diese Datei nach .env.local und fülle die Werte aus.
# =============================================================================

# Supabase Project URL (Settings → API → Project URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (Settings → API → anon public)
# Dieser Key ist für Client-seitige Anfragen (mit RLS)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Settings → API → service_role secret)
# ⚠️ ACHTUNG: Dieser Key umgeht RLS! NUR für Server-seitige Operationen!
# NIEMALS im Frontend verwenden!
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================================================
# 🔄 SYNC CONFIGURATION
# =============================================================================

# Sync aktivieren/deaktivieren
SYNC_ENABLED=true

# Auto-Sync Intervall in Millisekunden (Standard: 1 Stunde = 3600000)
SYNC_INTERVAL_MS=3600000

# Automatischer Push bei lokalen Änderungen
SYNC_AUTO_PUSH=true

# Automatischer Pull bei App-Start
SYNC_AUTO_PULL=true

# Konflikt-Strategie: 'local_wins' | 'remote_wins' | 'manual'
SYNC_CONFLICT_STRATEGY=remote_wins
